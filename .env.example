# ==============================================================================
# AgriClimate: NASA-Powered Climate Intelligence Platform
# Environment Configuration Template (.env.example)
#
# Copy this file to .env.local (or .env) and fill in your values.
# Do NOT commit secrets (.env or .env.local) to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Operation Mode
# ------------------------------------------------------------------------------
# Options:
#   - 'hybrid' : Uses live NASA telemetry if available/fresh, with instant static fallback (Recommended)
#   - 'live'   : Attempts live NASA APIs on every sync cycle
#   - 'static' : Operates strictly from frozen local seed data in data/generated/
DATA_SOURCE_MODE=hybrid

# Public deployment URL (used for absolute callbacks and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. NASA Satellite Data Feeds
# ------------------------------------------------------------------------------
# NASA POWER Agroclimatology REST API (Public, Zero Authentication Required)
# Base endpoint for daily weather, precipitation, solar radiation, humidity
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# NASA FIRMS (Fire Information for Resource Management System)
# Used for real-time VIIRS 375m active fire and stubble burn detections
# Obtain a free instant MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# NASA Earthdata Login (Optional, used for raw AppEEARS and CMR raster downloads)
# Free registration at: https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Microsoft Planetary Computer STAC (Public, Zero Authentication Required)
# Used for Landsat 8/9 Collection 2 Level 2 30m surface reflectance
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# ------------------------------------------------------------------------------
# 3. Cache TTL Settings (in seconds)
# ------------------------------------------------------------------------------
CACHE_TTL_POWER=21600       # 6 hours (NASA POWER daily updates)
CACHE_TTL_FIRMS=3600        # 1 hour (VIIRS NRT thermal pass)
CACHE_TTL_SATELLITE=86400   # 24 hours (MODIS / SMAP L4)

# ------------------------------------------------------------------------------
# 4. Ingestion Security & Scheduled Cron
# ------------------------------------------------------------------------------
# Bearer secret token required to invoke /api/sync/live-nasa from Vercel Cron or GitHub Actions
CRON_SECRET_KEY=generate_a_secure_random_token_here

# ------------------------------------------------------------------------------
# 5. Outbound SMS & Telecom Gateway (Optional: For Production Alert Dispatch)
# ------------------------------------------------------------------------------
# If omitted, the dispatch endpoint operates in prototype mode (HTTP 501 simulation)
SMS_GATEWAY_PROVIDER=mock
# SMS_GATEWAY_API_KEY=your_telecom_or_twilio_api_key
# SMS_GATEWAY_API_SECRET=your_telecom_api_secret
# SMS_SENDER_ID=AGRICLIMATE

# ------------------------------------------------------------------------------
# 6. Conversational Voice AI (Optional: For Speech-to-Text & Query Assistant)
# ------------------------------------------------------------------------------
# If omitted, the voice assistant operates in interactive simulation mode (HTTP 501)
# OPENAI_API_KEY=sk-your_openai_key_here
# GEMINI_API_KEY=your_google_ai_gemini_key_here

# ------------------------------------------------------------------------------
# 7. Map Services (Google Maps API & Basemap)
# ------------------------------------------------------------------------------
# Google Maps JavaScript API key for satellite and hybrid land view
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

